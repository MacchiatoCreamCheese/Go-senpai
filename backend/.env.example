# Comma-separated list of frontend origins allowed to call this backend.
# Add your teammates' machines if they connect to your backend over the LAN.
# Example: CORS_ORIGINS=http://localhost:5173,http://192.168.1.42:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Get this from Supabase Dashboard → Project Settings → Database → Connection string (Session pooler)
DATABASE_URL=postgresql://postgres.vrsogktirpdmbkjvyxky:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# KataGo (Phase 1: feature extraction). Leave disabled if you don't have it.
KATAGO_ENABLED=false
KATAGO_BIN=C:\tools\katago\katago.exe
KATAGO_CONFIG=C:\tools\katago\analysis.cfg
KATAGO_MODEL=C:\tools\katago\kata1-zhizi-b28c512nbt-muonfd2.bin.gz
KATAGO_MAX_VISITS=500
KATAGO_RULES=chinese
# Wall-time budget per analyze() call: max(KATAGO_ANALYZE_TIMEOUT,
# KATAGO_TIMEOUT_PER_TURN * turns). Raise these if you see TimeoutError
# on large games or CPU-only KataGo.
KATAGO_ANALYZE_TIMEOUT=60
KATAGO_TIMEOUT_PER_TURN=8

# Phase 2: LLM review.
# Pick ONE provider and model; only the matching API key must be set.
#   claude: ANTHROPIC_API_KEY  (e.g. model=claude-haiku-4-5, claude-sonnet-4-6)
#   gemini: GOOGLE_API_KEY     (e.g. model=gemini-2.5-flash,  gemini-2.5-pro)
REVIEW_LLM_PROVIDER=gemini
REVIEW_LLM_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
REVIEW_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
