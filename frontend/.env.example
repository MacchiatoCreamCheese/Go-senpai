# Copy to .env.local and fill in real values from your Supabase project.
# Never commit .env.local to git.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# If a teammate is running the backend, point here instead of localhost.
# Example: VITE_API_URL=http://192.168.1.10:8000
# Leave unset to use your own localhost:8000.
# VITE_API_URL=http://localhost:8000
